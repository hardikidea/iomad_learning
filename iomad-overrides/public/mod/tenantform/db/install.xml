<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/tenantform/db" VERSION="2026072500" COMMENT="XMLDB file for mod_tenantform"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="tenantform" COMMENT="Tenant-aware form activity definitions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="companyid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="formtype" TYPE="char" LENGTH="40" NOTNULL="true" DEFAULT="custom" SEQUENCE="false"/>
        <FIELD NAME="definitionjson" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="brandingjson" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="allowguest" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="notify" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="targetcourseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="autoenrol" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course_fk" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="company" UNIQUE="false" FIELDS="companyid"/>
        <INDEX NAME="course_type" UNIQUE="false" FIELDS="course, formtype"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="tenantform_entry" COMMENT="Immutable submitted form data">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="tenantformid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="companyid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="submissiontoken" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="submitted" SEQUENCE="false"/>
        <FIELD NAME="datajson" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="checksum" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="filecount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="tenantform_fk" TYPE="foreign" FIELDS="tenantformid" REFTABLE="tenantform" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="form_time" UNIQUE="false" FIELDS="tenantformid, timecreated"/>
        <INDEX NAME="company_time" UNIQUE="false" FIELDS="companyid, timecreated"/>
        <INDEX NAME="user_time" UNIQUE="false" FIELDS="userid, timecreated"/>
        <INDEX NAME="checksum" UNIQUE="false" FIELDS="checksum"/>
        <INDEX NAME="form_token" UNIQUE="true" FIELDS="tenantformid, submissiontoken"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="tenantform_audit" COMMENT="Non-content form entry audit">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="tenantformid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="entryid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="companyid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="action" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="tenantform_fk" TYPE="foreign" FIELDS="tenantformid" REFTABLE="tenantform" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="entry_time" UNIQUE="false" FIELDS="entryid, timecreated"/>
        <INDEX NAME="company_time" UNIQUE="false" FIELDS="companyid, timecreated"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
