# Local Floci control plane.
FLOCI_COMPOSE_PROJECT_NAME=iomad_learning_floci
FLOCI_NETWORK_NAME=iomad_learning_floci
FLOCI_ENDPOINT=http://localhost:4566
FLOCI_INTERNAL_ENDPOINT=http://floci:4566
FLOCI_UI_PORT=4500
FLOCI_ELASTICACHE_PROXY_BASE_PORT=16380
FLOCI_ELASTICACHE_PROXY_MAX_PORT=16400
FLOCI_RDS_PROXY_BASE_PORT=7001
FLOCI_RDS_PROXY_MAX_PORT=7099
FLOCI_POSTGRES_IMAGE=postgres:16.14-bookworm
FLOCI_REDIS_IMAGE=redis:7.4.9-bookworm

# These are emulator identifiers, not production credentials.
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ACCOUNT_ID=000000000000
TF_ENVIRONMENT=dev

# Application endpoint for the decoupled Nginx/PHP-FPM stack.
IOMAD_LOCAL_HTTP_PORT=18081
IOMAD_LOCAL_WWWROOT=http://localhost:18081
IOMAD_NOREPLY_ADDRESS=noreply@example.com
IOMAD_DISABLE_EMAIL=true

# Optional overrides. Database and administrator passwords are generated into
# ignored .env.local.secrets and are never printed.
# FLOCI_DB_PASSWORD=
# IOMAD_ADMIN_PASSWORD=
