# Local Docker project name.
COMPOSE_PROJECT_NAME=iomad_learning

# Pinned official IOMAD source. Do not deploy a floating branch.
IOMAD_REPO=https://github.com/iomad/iomad.git
IOMAD_REF=IOMAD_501_STABLE
IOMAD_COMMIT=55b3128b8058d27f6cc4320850ca709ed5a792a9
IOMAD_SERIES=5.1

# Deterministic local image versions.
PHP_IMAGE=php:8.3-fpm-bookworm
COMPOSER_IMAGE=composer:2.8.10
PHPREDIS_VERSION=6.3.0
POSTGRES_IMAGE=postgres:16-bookworm
REDIS_IMAGE=redis:7-bookworm
MAILPIT_IMAGE=axllent/mailpit:v1.27.8
INCLUDE_IOMAD_SOURCE=true

# Local web URL. Keep this in sync with IOMAD_HTTP_PORT.
IOMAD_HTTP_PORT=18080
IOMAD_TENANT_HTTP_PORT=80
IOMAD_WWWROOT=http://localhost:18080
TENANT_HOSTNAMES=trust.localhost,school.localhost,university.localhost,engineering.localhost

# IOMAD paths inside the container.
IOMAD_DIR=/var/www/iomad
IOMAD_DATAROOT=/var/www/iomaddata

# IOMAD database settings.
IOMAD_DB_TYPE=pgsql
IOMAD_DB_HOST=db
IOMAD_DB_PORT=5432
IOMAD_DB_PREFIX=mdl_

# PostgreSQL settings.
POSTGRES_DB=iomad
POSTGRES_USER=iomad
POSTGRES_PASSWORD=iomad_dev_password
POSTGRES_PORT=15440

# Local Redis and MailPit services.
REDIS_PORT=16379
IOMAD_REDIS_HOST=redis
IOMAD_REDIS_PORT=6379
IOMAD_REDIS_DATABASE=0
IOMAD_REDIS_PREFIX=iomad_session_
MAILPIT_SMTP_PORT=11025
MAILPIT_UI_PORT=18025
IOMAD_SMTP_HOSTS=mailpit:1025
IOMAD_NOREPLY_ADDRESS=noreply@example.local

# First local administrator account used by scripts/install-site.sh.
# Change these before any shared or production-like deployment.
IOMAD_ADMIN_USER=admin
IOMAD_ADMIN_PASSWORD=Admin123!ChangeMe
IOMAD_ADMIN_EMAIL=admin@example.local
IOMAD_SITE_FULLNAME="IOMAD Learning Local"
IOMAD_SITE_SHORTNAME=iomadlearning
IOMAD_THEME=iomad_learning
IOMAD_AUTH_PLUGINS=email,iomadoidc

# Demo import safety. Demo passwords are permitted only for local installs.
INSTITUTIONPACK_ALLOW_DEMO_PASSWORDS=true
INSTITUTIONPACK_DEFAULT_PASSWORD=DemoOnly2026!
INSTITUTIONPACK_DEFAULT_PACK=institution-packs/school/sample

# Runtime settings.
TZ=Asia/Kolkata
IOMAD_CRON_INTERVAL=60
IOMAD_CRON_HEALTH_MAX_AGE=900
IOMAD_BACKUP_STATUS_FILE=/var/backups/iomad/latest.env
IOMAD_ENVIRONMENT=local
IOMAD_COMPOSER_INSTALL=true
IOMAD_REVERSEPROXY=false
IOMAD_SSLPROXY=false

# Optional observability profile. Generate the bearer token with
# scripts/init-observability.sh; never place its value in this file.
IOMAD_MONITOR_METRICS_TOKEN_FILE=/run/secrets/monitor_metrics_token
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Optional local recovery-set destination and audit reason.
# BACKUP_ROOT=/absolute/path/to/iomad-backups
# BACKUP_REASON=manual

# Optional local Compose runtime user override.
# The production image defaults to www-data (33:33). scripts/install-site.sh
# exports the current host UID/GID automatically so bind-mounted files remain writable.
# IOMAD_RUNTIME_UID=33
# IOMAD_RUNTIME_GID=33
